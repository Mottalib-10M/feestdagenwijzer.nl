---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/feestdagen/" title="Countdown to the next Dutch public holiday" width="100%" height="560" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed Feestdagenwijzer: countdown to the next Dutch holiday" description="Show the countdown to the next Dutch public holiday for free on your club, school or newsroom website: copy the code once and the following years then appear by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed Feestdagenwijzer</h1>
    <p class="mt-3 text-lg text-navy-700">For staff associations, sports clubs, schools and local media: copy once, and the countdown rolls on to the next year by itself.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Countdown to the next holiday</h2>
    <p>Visitors see how long until the next official public holiday, whether it is usually a day off, the holidays after it and the next school break of their region.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>For the Dutch version, replace /embed/en/ with /embed/nl/. Terms: the source line under the countdown stays visible, the countdown is not altered and it comes without warranty. What visitors choose stays on their device. Questions via <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/feestdagen/`} title="Countdown to the next Dutch public holiday" width="100%" height="560" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>

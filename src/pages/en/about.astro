---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Feestdagenwijzer: publisher, sources and independence';
const description = 'Who makes Feestdagenwijzer: Radif Partners, independent of government, unions and employers. Where the Dutch holidays, bridge days and school breaks come from.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About {SITE_NAMES[lang]}</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why this site exists</h2>
    <p>Searching for the 2027 Dutch holidays in November 2026 mostly turned up lists: some still showing 2023, others with Ascension on the wrong Thursday, and none working out what a leave day next to a holiday buys you. This site puts the official list next to the weekday, says for each holiday what the government writes about having it off, computes bridge days and working days, and adds the school breaks of the three regions.</p>
    <h2>Who publishes it</h2>
    <p>The publisher is {AUTHOR_NAME}, a company that builds calculators on public rules. {AUTHOR_NAME} is not a government service, a union or an employers' body, has no tie to any ministry and uses no official logos. The site sells no trips or holiday homes and carries no affiliate links.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the data comes from</h2>
    <p>The holidays are on the <Fragment set:html={s('gov-feestdagen-en', 'government list')} />, the school breaks in the <Fragment set:html={s('rijks-sv-2026', 'overviews per school year')} /> and the <Fragment set:html={s('rijks-regios', 'regional split')} />, all published under <Fragment set:html={s('rijks-copyright', 'CC0 1.0')} />. Deadlines follow the <Fragment set:html={s('termijnenwet', 'General Time Limits Act')} />. How everything is computed is on the <a href={route('method', lang)}>method</a> page; how we fix errors, in the <a href={route('editorial', lang)}>editorial policy</a>.</p>
    <h2>Your data</h2>
    <p>Every tool runs in your browser. Nothing you enter is sent or stored, and there is no account. See the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>What the site does not do</h2>
    <p>It decides nothing about your leave and does not know your agreement. Ask your employer whether Good Friday or 5 May is a day off for you.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> if a date or explanation is wrong.</p>
  </article>
</PageLayout>

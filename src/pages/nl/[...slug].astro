---
/** Elke onderwerppagina (src/content/guides), versie nl. */
import ContentPage from '../../components/ContentPage.astro';
import { GUIDES } from '../../lib/pages';
import type { GuideDef } from '../../lib/page-types';
export function getStaticPaths() {
  return GUIDES.filter((page) => page.nl).map((page) => ({ params: { slug: page.nl!.slug }, props: { page } }));
}
const { page } = Astro.props as { page: GuideDef };
---
<ContentPage page={page} lang="nl" />

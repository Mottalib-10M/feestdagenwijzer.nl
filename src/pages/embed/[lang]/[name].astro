---
/** Pagina om in te sluiten (iframe): alleen de aftelling naar de volgende feestdag, in twee talen. noindex, niet in de sitemap. */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import type { Lang } from '../../../lib/format';
const EMBEDS = {
  feestdagen: { kind: 'aftellen', page: 'home', t: { nl: 'Volgende feestdag in Nederland', en: 'Next public holiday in the Netherlands' } },
} as const;
export function getStaticPaths() {
  return (['nl', 'en'] as const).flatMap((lang) => ['feestdagen'].map((name) => ({ params: { lang, name } })));
}
const { lang, name } = Astro.params as { lang: Lang; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route(e.page, lang)}`;
const note = { nl: 'Wat u kiest blijft op uw toestel · rekenhulp van Radif Partners, geen dienst van de overheid', en: 'What you choose stays on your device · tool by Radif Partners, not a government service' }[lang];
const emb = { nl: 'om in te sluiten', en: 'embed' }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${emb})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind={e.kind} lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {note}</p>
  </body>
</html>

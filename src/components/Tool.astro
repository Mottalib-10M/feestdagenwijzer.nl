---
/** Het hulpmiddel van een pagina: een declaratieve rekenhulp uit tool-specs.ts, de jaarkalender of de aftelling naar de volgende feestdag. */
import SpecTool from './calc/SpecTool';
import Kalender from './bt/Kalender';
import Aftellen from './bt/Aftellen';
import { route } from '../i18n/routes';
import type { Lang } from '../lib/format';
interface Props { kind: string; lang: Lang; arg?: Record<string, number | string>; idPrefix?: string }
const { kind, lang, arg, idPrefix = 't' } = Astro.props;
const methodHref = route('method', lang);
---
{kind === 'kalender' ? <Kalender client:load lang={lang} year={Number(arg?.jaar ?? 2027)} regio={arg?.regio ? String(arg.regio) : undefined} methodHref={methodHref} idPrefix={idPrefix} />
  : kind === 'aftellen' ? <Aftellen client:load lang={lang} regio={arg?.regio ? String(arg.regio) : undefined} methodHref={methodHref} idPrefix={idPrefix} />
  : <SpecTool client:load kind={kind} lang={lang} arg={arg ? JSON.stringify(arg) : undefined} methodHref={methodHref} idPrefix={idPrefix} />}
